# Environment
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Generated data — reproducible from the seeded generator, not committed.
# Test fixtures are exempt: they're small, hand-written, and part of the
# suite's meaning, so a blanket *.csv would silently drop them.
*.csv
!tests/fixtures/*.csv

# Trained model artifacts — reproducible via ml/train.py, EXCEPT the one
# version pinned below: main.py loads the latest artifact directory at
# import time (boot-time, not per-request), so Render needs a real model
# on disk the moment it clones this repo, and training data (*.csv, also
# gitignored above) isn't committed for it to retrain from on deploy.
# If you retrain and want the new version deployed, update the pinned
# path here to match, then commit the new (small) artifact directory.
ml/artifacts/*
!ml/artifacts/2026-08-06-055755/
!ml/artifacts/2026-08-06-055755/**

# Virtual environments
.venv/
venv/
