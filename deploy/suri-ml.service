# systemd unit for the SURI ML fertilizer service.
# Install once: sudo cp deploy/suri-ml.service /etc/systemd/system/suri-ml.service
#               sudo systemctl daemon-reload && sudo systemctl enable --now suri-ml

[Unit]
Description=SURI ML fertilizer prediction service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/suri-ml-backend
EnvironmentFile=/opt/suri-ml-backend/.env
ExecStart=/opt/suri-ml-backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
