# Copy these from suri/.env.local — the ML service shares suri's Supabase project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required on /predict's X-API-Key header once this is
# reachable from outside the instance. Leave unset for local dev/tests --
# /predict stays open when this is empty. Generate with:
#   openssl rand -hex 32
# suri's app/api/ml-fertilizer/route.ts must send the same value.
ML_API_KEY=
